{
  "name": "upperglam-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "node scripts/run-android.js",
    "android:check": "node scripts/check-android-env.js",
    "android:dev": "node scripts/run-android.js",
    "android:dev:clean": "node scripts/run-android.js --no-build-cache",
    "android:dev-client": "expo start --dev-client",
    "android:device": "node scripts/run-android-device.js",
    "android:install-apk": "node scripts/install-android-apk.js",
    "android:apk": "npx eas-cli build --platform android --profile preview",
    "android:aab": "npx eas-cli build --platform android --profile production",
    "prebuild": "npx expo prebuild --clean",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "workflow:check": "npm run lint && npm run type-check && npm test",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/stack": "^7.10.17",
    "axios": "^1.18.1",
    "expo": "~57.0.8",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "posthog-react-native": "^4.61.1",
    "react": "19.2.8",
    "react-hook-form": "^7.83.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "~19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~55.0.12",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "private": true
}
